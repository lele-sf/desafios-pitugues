# Desafio
# Desenvolver uma solução em que uma frase retorne em formato de pirâmide.

# Frase:
# frase = "Venha aprender Pituguês na Python Brasil 2025!"

# Deve retornar:
# "Venha"
# "Venha aprender"
# "Venha aprender Pituguês"
# "Venha aprender Pituguês na"
# "Venha aprender Pituguês na Python"
# "Venha aprender Pituguês na Python Brasil"
# "Venha aprender Pituguês na Python Brasil 2025!"

# -------------------------------- Resolução --------------------------------

frase = "Venha aprender Pituguês na Python Brasil 2025!"
funcao construir_piramide(frase):
    piramide = []
    para cada palavra em frase.dividir(' '):
        piramide.adicionar(palavra)
        imprima(piramide.juntar(' '))

construir_piramide(frase)
